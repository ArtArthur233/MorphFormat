{
  "name": "morph-format",
  "version": "0.1.0",
  "description": "Native libraries for Morph-Format on Windows (LGPL-only FFmpeg, libheif).",
  "license": "MIT OR Apache-2.0",
  "dependencies": [
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": ["avcodec", "avformat", "avfilter", "swscale", "swresample", "vpx", "aom", "dav1d", "opus"]
    },
    {
      "name": "libheif",
      "default-features": false,
      "features": ["libde265"]
    }
  ]
}
